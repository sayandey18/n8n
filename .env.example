# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. Never commit the real .env file to version control.
# ---------------------------------------------------------------------------

# Public hostname n8n will be reached at. Must match:
#   1) the DNS A/AAAA record pointing at this server, and
#   2) the Proxy Host domain you create in Nginx Proxy Manager.
N8N_HOST=n8n.example.com

# IANA timezone, used for Cron trigger nodes, Watchtower's schedule, and logs.
GENERIC_TIMEZONE=Etc/UTC

# --- Postgres (external, Aiven-managed) --------------------------------------
DB_POSTGRESDB_HOST=pg-n8n-n8n-cloud.k.aivencloud.com
DB_POSTGRESDB_PORT=12305
DB_POSTGRESDB_DATABASE=defaultdb
DB_POSTGRESDB_USER=avnadmin
DB_POSTGRESDB_PASSWORD=replace-with-your-real-aiven-password

# --- n8n secrets --------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# N8N_ENCRYPTION_KEY encrypts stored credentials - back it up, never rotate
# it casually, and never lose it (you'd lose access to saved credentials).
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Shared secret between the n8n container and the n8n-runners container.
N8N_RUNNERS_AUTH_TOKEN=replace-with-openssl-rand-hex-32
